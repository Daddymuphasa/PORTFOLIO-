# papagedon.com/app — all values are public (NEXT_PUBLIC_*) and baked in at build time.
# Copy to .env.local for local dev, or set them in the Vercel project settings.

# Paid AEI gateway (x402). Leave empty until the gateway is deployed: the panel
# then shows "Gateway not live" and never asks a wallet to sign anything.
NEXT_PUBLIC_AEI_GATEWAY_URL=
# Path of the paid endpoint on that gateway.
NEXT_PUBLIC_AEI_ENDPOINT_PATH=/v1/aei/signals
# The UI refuses to sign any quote above this (USDC per call).
NEXT_PUBLIC_AEI_MAX_PRICE_USDC=0.05

# WalletConnect / Reown Cloud project id (https://cloud.reown.com). Optional:
# without it only browser wallets (MetaMask, Rabby, Valora, MiniPay) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Celo mainnet RPC used for reads (identity check, wallet transport).
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
