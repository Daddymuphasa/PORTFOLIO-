# papagedon.com — copy to .env.local for local dev, or set these in Vercel
# (Project → Settings → Environment Variables).

# ── Browser (NEXT_PUBLIC_*: public, baked in at build time) ──────────────────

# PAPAGEDON Vision: HTTPS base URL of the OpenCV 5 service on AWS
# (printed by vision-service/deploy/deploy.sh, e.g. https://dxxxx.cloudfront.net).
# Empty -> /app analyses the camera in the browser instead.
NEXT_PUBLIC_VISION_SERVICE_URL=

# ── Server only (never NEXT_PUBLIC_) ─────────────────────────────────────────

# AEI Meta director (app/api/aei/cue). Empty until the key arrives.
# The rule director on /aei does not read this.
MODEL_API_KEY=
