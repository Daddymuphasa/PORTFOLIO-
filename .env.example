# papagedon.com — copy to .env.local for local dev, or set these in Vercel
# (Project → Settings → Environment Variables).

# ── Browser (NEXT_PUBLIC_*: public, baked in at build time) ──────────────────

# PAPAGEDON Vision: HTTPS base URL of the OpenCV 5 service on AWS
# (printed by vision-service/deploy/deploy.sh, e.g. https://dxxxx.cloudfront.net).
# Empty -> /app analyses the camera in the browser instead.
NEXT_PUBLIC_VISION_SERVICE_URL=

# ── Server only (never NEXT_PUBLIC_) ─────────────────────────────────────────

# Meta model key. Empty runs AEI in mock mode. Never prefix with NEXT_PUBLIC_.
MODEL_API_KEY=
# Optional base URL override, used only after lib/aei/apiConfig.ts is confirmed.
MODEL_API_BASE_URL=
# Optional model id overrides. Defaults: muse-spark-1.3, sam-3.1, muse-image-1.0.
MODEL_ID_MUSE_SPARK=
MODEL_ID_SAM=
MODEL_ID_MUSE_IMAGE=
# Optional. Reserved for later file storage. Unused while packs stay on local disk.
AEI_STORAGE_TOKEN=
# Optional. Reserved for a deploy hook. Unused by the local spikes.
AEI_DEPLOY_TOKEN=
