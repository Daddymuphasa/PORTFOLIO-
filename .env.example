# papagedon.com — copy to .env.local for local dev, or set these in Vercel
# (Project → Settings → Environment Variables).

# ── Browser (NEXT_PUBLIC_*: public, baked in at build time) ──────────────────

# Where the /app panel sends paid AEI calls.
#   empty        -> paid calls are off; the panel says "Gateway not live" and
#                   never asks a wallet to sign anything
#   same-origin  -> this site's own gateway at /v1/aei/signals (recommended;
#                   works on production and preview deployments alike)
#   https://...  -> a gateway hosted somewhere else
NEXT_PUBLIC_AEI_GATEWAY_URL=
# Path of the paid endpoint on that gateway.
NEXT_PUBLIC_AEI_ENDPOINT_PATH=/v1/aei/signals
# The UI refuses to sign any quote above this (USDC per call).
NEXT_PUBLIC_AEI_MAX_PRICE_USDC=0.05

# WalletConnect / Reown Cloud project id (https://cloud.reown.com). Optional:
# without it only browser wallets (MetaMask, Rabby, Valora, MiniPay) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Celo mainnet RPC used for reads (identity check, wallet transport).
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

# ── Server (the paid AEI gateway, app/v1/aei/*). Never exposed to browsers. ──

# Celo x402 facilitator API key: create it at https://x402.celo.org (connect a
# wallet, "Create API key", sign the off-chain message; no gas). Only /settle
# needs it. Without it the gateway answers 503 and asks nobody to pay.
# SECRET: set it in Vercel only, never commit it.
X402_API_KEY=
# Wallet that receives the USDC. The /app panel only signs payments to the
# PAPAGEDON wallet below, so leave this unless you also change lib/aei/config.ts.
AEI_PAY_TO=0x9A47cC17077ea358052FF6233d8aBEe0041E35ed
# Price per call in USDC (USDT is offered at the same price).
AEI_PRICE_USDC=0.01
# celo (mainnet, default) or celo-sepolia (testnet; the /app panel only pays mainnet).
AEI_NETWORK=celo
# Optional: override the facilitator (defaults to https://api.x402.celo.org,
# or https://api.x402.sepolia.celo.org for celo-sepolia).
X402_FACILITATOR_URL=
# Optional limits (bytes are capped at 4000000 because Vercel rejects bodies over 4.5 MB).
AEI_MAX_BYTES=4000000
AEI_MAX_SECONDS=60
